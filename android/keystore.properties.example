# =============================================================================
# keystore.properties.example
# =============================================================================
# 이 파일을 복사해서 android/keystore.properties 를 만드세요.
# keystore.properties 는 .gitignore 에 등록되어 있으므로 git에 커밋되지 않습니다.
#
#   cp keystore.properties.example keystore.properties
#   # 그런 다음 아래 값을 실제 키스토어 정보로 채우세요.
#
# 키스토어 생성 명령 (한 번만 실행, 안전한 곳에 .jks 파일 보관):
#   keytool -genkey -v \
#     -keystore ~/my-release-key.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias my-key-alias
# =============================================================================

# 키스토어 파일 경로 (android/ 기준 상대경로 또는 절대경로)
storeFile=../my-release-key.jks

# 키스토어 비밀번호 (keytool 생성 시 입력한 값)
storePassword=YOUR_STORE_PASSWORD

# 키 별칭 (keytool -alias 에 입력한 값)
keyAlias=YOUR_KEY_ALIAS

# 키 비밀번호
keyPassword=YOUR_KEY_PASSWORD
