<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <!-- 툴바 -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:title="IMU 실내 측위"
            app:titleTextColor="#FFFFFF"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 콘텐츠 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 캘리브레이션 안내 카드 (영점 보정 중에만 표시) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/calibCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:visibility="gone"
                app:cardBackgroundColor="#FFF8E1"
                app:cardElevation="2dp"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvCalibTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="센서 영점 보정 중"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#E65100"/>

                    <TextView
                        android:id="@+id/tvCalibHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="캘리브레이션을 위해 2초간 기기를 가만히 두세요."
                        android:textSize="13sp"
                        android:textColor="#5D4037"/>

                    <ProgressBar
                        android:id="@+id/calibProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progress="0"/>

                    <TextView
                        android:id="@+id/tvCalibPercent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="end"
                        android:text="0 %"
                        android:textSize="12sp"
                        android:textColor="#9E6B00"
                        android:fontFamily="monospace"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 경로 뷰 (모델+EKF 파랑 / 모델only 주황 동시 표시) -->
            <com.imulocal.TrackView
                android:id="@+id/trackView"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:background="#FFFFFF"
                android:elevation="2dp"/>

            <!-- 상태 정보 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView android:id="@+id/tvPosition"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="[EKF] x=0.000  y=0.000  z=0.000 m"
                        android:textSize="14sp"
                        android:textColor="#1565C0"
                        android:fontFamily="monospace"/>

                    <TextView android:id="@+id/tvStd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="σ  x=0.0000  y=0.0000  z=0.0000 m"
                        android:textSize="13sp"
                        android:textColor="#757575"
                        android:fontFamily="monospace"
                        android:layout_marginTop="4dp"/>

                    <TextView android:id="@+id/tvVelocity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="속도  |v|=0.00 m/s"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"/>

                    <TextView android:id="@+id/tvCarryMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="휴대 방식: unknown (0%)"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"/>

                    <TextView android:id="@+id/tvLatency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="추론 지연: 0 ms"
                        android:textSize="12sp"
                        android:textColor="#9E9E9E"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 제어 버튼 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="시작"
                    android:layout_marginEnd="6dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="정지"
                    android:enabled="false"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_marginEnd="6dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="초기화"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
