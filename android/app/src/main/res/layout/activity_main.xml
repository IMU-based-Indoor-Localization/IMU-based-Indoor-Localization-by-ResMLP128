<?xml version="1.0" encoding="utf-8"?>
<!--
  [P68-5] 격자/지도 표시 모드 토글 layout.
  구조 (수직 LinearLayout):
    1) Toolbar
    2) calibCard (상단 임시 카드, 보정 중에만)
    3) FrameLayout weight=1 (메인 view 영역, 토글로 두 view 전환):
       - TrackView    (1m 격자, 기본 visible)
       - MapFragment  (Naver Map, 토글 시 visible)
    4) infoCard (하단 — 정보 + 시작/정지/초기화 + Replay, 두 모드 공통)
  토글: 메뉴 → "표시 모드: 격자 / 지도".
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <!-- 툴바 -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="IMU 실내 측위"
        app:titleTextColor="#FFFFFF"/>

    <!-- 캘리브 카드 (보정 중에만) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/calibCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:visibility="gone"
        app:cardBackgroundColor="#FFF8E1"
        app:cardElevation="2dp"
        app:cardCornerRadius="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvCalibTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="센서 영점 보정 중"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#E65100"/>

            <TextView
                android:id="@+id/tvCalibHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="캘리브레이션을 위해 2초간 기기를 가만히 두세요.\n측위는 폰을 진행 방향으로 들고 보행하는 HANDHELD 자세를 권장합니다."
                android:textSize="13sp"
                android:textColor="#5D4037"/>

            <ProgressBar
                android:id="@+id/calibProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="0"/>

            <TextView
                android:id="@+id/tvCalibPercent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:text="0 %"
                android:textSize="12sp"
                android:textColor="#9E6B00"
                android:fontFamily="monospace"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 메인 view 영역 (TrackView ↔ MapFragment 토글) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 격자 모드 (기본 visible) -->
        <com.imulocal.TrackView
            android:id="@+id/trackView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:elevation="1dp"/>

        <!-- 지도 모드 (토글 시 visible). [P68-5 fix] gone 대신 invisible 사용 —
             gone 은 view measure 자체를 건너뛰어 onMapReady 시점에 카메라 위치 설정이
             무시될 수 있다. invisible 은 공간 점유하지만 안 보임 (Map 정상 init). -->
        <fragment
            android:id="@+id/map"
            android:name="com.naver.maps.map.MapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible"/>

        <!-- [P74] 재생 슬라이더 + 시간 라벨 (지도 모드일 때만 보임, 항상 하단).
             scrub 모드: 0~100% 위치의 polyline 인덱스에 cursor marker 배치.
             100% = 라이브 (자동 추적). 100% 미만 = 사용자 scrub. 학술 시연 종료 후 P70 시리즈와 함께 제거 예정. -->
        <LinearLayout
            android:id="@+id/replayControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="#CCFFFFFF"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvReplayTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="t = 0.00s / 0.00s   (라이브)"
                android:textSize="11sp"
                android:textColor="#424242"
                android:fontFamily="monospace"
                android:gravity="end"/>

            <SeekBar
                android:id="@+id/replaySeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="100"/>
        </LinearLayout>
    </FrameLayout>

    <!-- 정보 + 버튼 카드 (두 모드 공통, 항상 하단) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:cardElevation="2dp"
        app:cardCornerRadius="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView android:id="@+id/tvPosition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="[위치] x=0.000  y=0.000  z=0.000 m"
                android:textSize="13sp"
                android:textColor="#1565C0"
                android:fontFamily="monospace"/>

            <TextView android:id="@+id/tvStd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="σ  x=0.0000  y=0.0000  z=0.0000 m"
                android:textSize="12sp"
                android:textColor="#757575"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp"/>

            <TextView android:id="@+id/tvVelocity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="속도  |v|=0.00 m/s"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>

            <!-- [P58] 휴대 방식(분류기) 은 IMU 진단 화면 -->

            <TextView android:id="@+id/tvLatency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="추론 지연: 0 ms"
                android:textSize="11sp"
                android:textColor="#9E9E9E"
                android:layout_marginTop="2dp"/>

            <!-- 제어 버튼 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="시작"
                    android:layout_marginEnd="6dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="정지"
                    android:enabled="false"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_marginEnd="6dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="초기화"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>
            </LinearLayout>

            <!-- [P45-Replay] CSV 재생 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Replay (latest.csv 재생)"
                app:icon="@android:drawable/ic_media_play"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
