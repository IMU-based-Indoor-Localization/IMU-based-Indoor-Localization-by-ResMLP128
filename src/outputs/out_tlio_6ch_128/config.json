{
  "train_dir": "dataset_split/train",
  "val_dir": "dataset_split/val",
  "test_dir": "dataset_split/test",
  "window_len": 200,
  "train_stride": 10,
  "eval_stride": 10,
  "batch_size": 128,
  "num_workers": 4,
  "model": {
    "input_len": 200,
    "input_channel": 6,
    "patch_len": 20,
    "feature_dim": 128,
    "out_dim": 3,
    "active_func": "GELU",
    "extractor": {
      "name": "ResMLP",
      "layer_num": 6,
      "expansion": 2,
      "dropout": 0.2
    },
    "reg": {
      "name": "SimpleMean",
      "layer_num": 3,
      "dropout": 0.2
    },
    "use_classifier": false
  },
  "loss": {
    "cls_weight": 0.0,
    "dir_weight": 0.0,
    "label_smoothing": 0.0,
    "use_class_weights": false,
    "mse_epochs": 100
  },
  "optimizer": {
    "name": "Adam",
    "lr": 0.0005
  },
  "scheduler": {
    "name": "CosineAnnealingLR",
    "T_max": 150,
    "eta_min": 1e-06
  },
  "warmup_epochs": 5,
  "epochs": 200,
  "grad_clip": 1.0,
  "log_interval": 50,
  "save_every": 10,
  "early_stopping": 60,
  "output_dir": "out_tlio_6ch_128"
}