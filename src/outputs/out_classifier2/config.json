{
  "train_dir": "cls_split_7way/train",
  "val_dir": "cls_split_7way/val",
  "test_dir": "cls_split_7way/test",
  "fmt": "oxford",
  "with_label": true,
  "window_len": 100,
  "train_stride": 10,
  "eval_stride": 10,
  "batch_size": 128,
  "num_workers": 4,
  "model": {
    "input_len": 100,
    "input_channel": 6,
    "patch_len": 10,
    "feature_dim": 128,
    "out_dim": 3,
    "active_func": "GELU",
    "extractor": {
      "name": "ResMLP",
      "layer_num": 6,
      "expansion": 2,
      "dropout": 0.2
    },
    "reg": {
      "name": "PoseCondMean",
      "layer_num": 3,
      "dropout": 0.2
    },
    "classifier": {
      "num_classes": 7,
      "layer_num": 2,
      "dropout": 0.3,
      "pooling_type": "mean"
    },
    "use_classifier": true
  },
  "pretrained_reg": "outputs/out_tlio_6ch_128/checkpoints/best.pth",
  "pretrained_cls": "outputs/out_classifier_7way/checkpoints/best.pth",
  "loss": {
    "cls_weight": 0.3,
    "dir_weight": 0.0,
    "label_smoothing": 0.05,
    "use_class_weights": true,
    "mse_epochs": 30
  },
  "optimizer": {
    "name": "AdamW",
    "lr": 0.0001,
    "weight_decay": 0.0001
  },
  "scheduler": {
    "name": "CosineAnnealingLR",
    "T_max": 100,
    "eta_min": 1e-06
  },
  "warmup_epochs": 5,
  "epochs": 100,
  "grad_clip": 1.0,
  "log_interval": 50,
  "save_every": 10,
  "early_stopping": 30,
  "output_dir": "out_classifier2"
}