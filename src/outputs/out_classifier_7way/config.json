{
  "train_dir": "D:/TLIO/cls_split_7way/train",
  "val_dir": "D:/TLIO/cls_split_7way/val",
  "test_dir": "D:/TLIO/cls_split_7way/test",
  "window_len": 200,
  "train_stride": 100,
  "eval_stride": 100,
  "batch_size": 128,
  "num_workers": 4,
  "epochs": 80,
  "warmup_epochs": 5,
  "grad_clip": 1.0,
  "log_interval": 50,
  "early_stopping": 15,
  "output_dir": "D:/TLIO/out_classifier_7way",
  "augment": {
    "noise": true,
    "noise_std": 0.01,
    "scale": true,
    "scale_range": [
      0.95,
      1.05
    ]
  },
  "model": {
    "input_len": 200,
    "input_channel": 6,
    "patch_len": 20,
    "feature_dim": 128,
    "active_func": "GELU",
    "extractor": {
      "layer_num": 6,
      "expansion": 2,
      "dropout": 0.2
    },
    "classifier": {
      "num_classes": 7,
      "layer_num": 2,
      "dropout": 0.3,
      "pooling_type": "mean"
    }
  },
  "loss": {
    "label_smoothing": 0.05,
    "use_class_weights": true
  },
  "optimizer": {
    "name": "AdamW",
    "lr": 0.0003,
    "weight_decay": 0.0001
  },
  "scheduler": {
    "name": "CosineAnnealingLR",
    "T_max": 80,
    "eta_min": 1e-06
  }
}